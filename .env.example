# =========================================================================
# VAIMA PRODUCTION ENVIRONMENTAL VARIABLES TEMPLATE
# =========================================================================
# This template lists all required and supporting environmental metrics for
# the VAIMA high-compliance industrial safety coworker engine. 
# 
# Copy this file to a local '.env' file during development, or configure these
# variables on your hosting control panel (e.g., Vercel, Cloud Run, Heroku).
# Never commit active private credentials to your version control repository.
# =========================================================================

# --- 1. CORE LARGE LANGUAGE MODEL INTERFACE ---
# Required for running all semantic safety generators, typesafe quizzes, and 
# on-site compliance checklists via the official Google Gemini SDK.
GEMINI_API_KEY="AIzaSyB-1845i4rfB6j6WtK6nVYWtrP4f28e7LE"

# --- 2. RETRIEVAL-AUGMENTED GENERATION METRICS ---
# The endpoint of your target ChromaDB server. If unset, VAIMA gracefully activates 
# the built-in Local Similarity Engine Fallback (Sim-LSE) using db.json for 100% uptime.
CHROMA_URL="http://localhost:8000"

# --- 3. INTERACTIVE AI AVATAR CONFIGURATION (WEBGL/WEBRTC) ---
# High-Fidelity Lip-Sync video stream. Used to obtain secure, session-isolated
# WebRTC access tokens. Get this value from your HeyGen corporate dashboard.
HEYGEN_API_KEY="sk_V2_hgu_kT9xXVufKA8_uvMdwADs9FKpfdXTd7IJZs6hw68DLYcC"

# --- 4. PRODUCTION ROUTING & WEB RUNTIME SCOPE ---
# Self-referencing absolute link of your online application deployment. 
# Used to compute secure redirect URIs, CORS rules, and secure API boundaries.
APP_URL="https://vaima-safety-coworker-demo.vercel.app"

# --- 5. SYSTEM ENVIRONMENT MODIFIER ---
# Used by Node express middlewares to bundle and minify production outputs.
NODE_ENV="production"

# --- 6. DURABLE CLOUD DATABASE PERSISTENCE (VERCEL EXCLUSIVE) ---
# Paste these directly from your Vercel Storage tab if integrating Vercel KV.
KV_URL=""
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# --- 7. ALTERNATIVE DURABLE SQL PERSISTENCE (SUPABASE EXTERNAL) ---
# Configure these if integrating a Supabase table store.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

